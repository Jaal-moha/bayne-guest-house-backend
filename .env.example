DATABASE_URL=postgresql://postgres:postgres@localhost:5432/guesthouse
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/guesthouse
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
PORT=3000
HOST=
# JSON array of exact origins, no trailing slash.
ALLOWED_ORIGINS=["http://localhost:3001"]
ATTENDANCE_API_KEY=

# Help page videos. Leave TUTORIALS_DIR empty to turn the store off: GET /tutorials returns [] and no media is served.
# The directory holds manifest.json and the mp4 and poster files it names. The API re-reads manifest.json when it changes.
TUTORIALS_DIR=
# Set exactly one signing key source when TUTORIALS_DIR is set. The key must have at least 32 characters.
# It signs the one-hour media links, so anyone holding it can mint links. Generate with: openssl rand -base64 48
TUTORIALS_SIGNING_SECRET=

# Prefer a mounted secret file in deployment, with no secret value in the container environment.
# UTF-8 contents, trailing whitespace removed. Unreadable or empty files prevent startup.
TUTORIALS_SIGNING_SECRET_FILE=
